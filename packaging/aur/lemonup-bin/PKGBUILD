pkgname=lemonup-bin
pkgver=2.9.1
pkgrel=1
pkgdesc='Terminal addon manager for World of Warcraft (Retail and WoW Forever)'
arch=('x86_64')
url='https://github.com/archcorsair/lemonup'
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=('lemonup')
conflicts=('lemonup')
options=('!debug')
source=("lemonup-${pkgver}::https://github.com/archcorsair/lemonup/releases/download/v${pkgver}/lemonup-linux-x64"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/archcorsair/lemonup/v${pkgver}/license")
sha256sums=('9b737e899a70158404a4fce4da76dbe6af27a24b8a14a5167cb69a6b1469c1fe'
            '59fc3a839c3c670e017ee18c7adf72c1a8d8af55a5176e2614e4ce02b3de5afa')

package() {
  install -Dm755 "lemonup-${pkgver}" "${pkgdir}/usr/bin/lemonup"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
