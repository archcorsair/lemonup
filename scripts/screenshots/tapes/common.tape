# Shared settings for every LemonUp screenshot tape (pulled in with Source).
# 2880x1620 at FontSize 32 renders a crisp 2x image of a ~140x36 terminal.
Set Shell "bash"
Set FontSize 32
Set FontFamily "JetBrains Mono,FiraCode Nerd Font Mono,DejaVu Sans Mono"
Set Width 2880
Set Height 1620
Set Theme "tokyonight-storm"
Set Padding 40
Set WindowBar Colorful
Set WindowBarSize 80
# Corners are rounded (with transparency) by generate.sh instead.
Set BorderRadius 0
Set Margin 0
Set TypingSpeed 20ms
